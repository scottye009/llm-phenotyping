logs/

# Local databases / raw data dumps — never commit patient data
*.duckdb
*.sqlite
*.sqlite3
*.db
*.bak
*.dump
data/
raw_data/
patient_data/

# Word lock/temp files
~$*.docx
~$*.xlsx

# Anything explicitly staged as SHIRE export pending approval
# (kept out of the repo until explicitly cleared for release)
**/pending_shire_export/
**/not_for_release/
